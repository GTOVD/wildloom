# ============================================================================
# Wildloom — Environment variables
# Copy to `.env` for local development.
# ============================================================================

# Postgres (used by Prisma + Auth.js)
POSTGRES_USER=wildloom
POSTGRES_PASSWORD=wildloom_dev
POSTGRES_DB=wildloom
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wildloom:wildloom_dev@localhost:5432/wildloom?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev-mode auth bypass — set to "1" to skip Google login locally.
# Refused in production builds (NODE_ENV=production).
AUTH_DEV_BYPASS=1
AUTH_DEV_USER_EMAIL=dev@wildloom.local
AUTH_DEV_USER_NAME=Dev Player

# Colyseus game server
COLYSEUS_PORT=2567
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567

# Next.js public game server endpoint (read on client)
NEXT_PUBLIC_APP_URL=http://localhost:3000
