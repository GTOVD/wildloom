{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildloom.dev/schemas/attack-template.schema.json",
  "title": "Wildloom attack template (player-composable frame)",
  "type": "object",
  "required": ["template_id", "display_name", "category", "customization"],
  "properties": {
    "template_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["strike", "surge", "true", "field", "channel", "reactive"]
    },
    "damage_kind_default": {
      "type": "string",
      "enum": ["endurance", "status", "utility"]
    },
    "mvp_resolver_note": {
      "type": "string",
      "description": "packages/combat Move today supports strike|surge|true — extended categories are design-forward."
    },
    "customization": { "$ref": "#/$defs/customizationBlock" },
    "suggested_tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "example_builds": {
      "type": "array",
      "items": { "$ref": "#/$defs/exampleBuild" }
    }
  },
  "$defs": {
    "affinity": {
      "type": "string",
      "enum": [
        "thermal",
        "cryo",
        "aqueous",
        "galvanic",
        "mineral",
        "flora",
        "aero",
        "luminous",
        "void",
        "sonic",
        "corrosive",
        "plasmic"
      ]
    },
    "numericRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": { "type": "number" },
        "step": { "type": "number" }
      }
    },
    "customizationBlock": {
      "type": "object",
      "required": ["primary_affinity", "secondary_affinity"],
      "properties": {
        "primary_affinity": {
          "type": "object",
          "required": ["required", "allow_null"],
          "properties": {
            "required": { "type": "boolean" },
            "allow_null": { "type": "boolean" },
            "choices_ref": { "type": "string" },
            "help": { "type": "string" }
          }
        },
        "secondary_affinity": {
          "type": "object",
          "required": ["required", "allow_null"],
          "properties": {
            "required": { "const": false },
            "allow_null": { "type": "boolean" },
            "must_differ_from_primary": { "type": "boolean" },
            "help": { "type": "string" }
          }
        },
        "blend_eta": {
          "type": "object",
          "description": "When secondary is set, portion of affinity_weights on secondary (remainder on primary unless advanced tail editor).",
          "properties": {
            "applies_when": { "type": "string" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "default": { "type": "number" },
            "step": { "type": "number" }
          }
        },
        "affinity_weights_rule": {
          "type": "object",
          "properties": {
            "when_secondary_null": { "type": "string" },
            "when_secondary_set": { "type": "string" },
            "advanced_simplex_tail": { "type": "boolean" }
          }
        },
        "base_power": { "$ref": "#/$defs/numericRange" },
        "pierce": { "$ref": "#/$defs/numericRange" },
        "accuracy": {
          "allOf": [
            { "$ref": "#/$defs/numericRange" },
            {
              "properties": {
                "optional": { "type": "boolean" },
                "omit_means_always_hit": { "type": "boolean" }
              }
            }
          ]
        },
        "strike_modalities": {
          "type": ["object", "null"],
          "description": "Strike-only delivery ω — null ⇒ concussive-only legacy path",
          "properties": {
            "concussive": { "$ref": "#/$defs/numericRange" },
            "piercing": { "$ref": "#/$defs/numericRange" },
            "slashing": { "$ref": "#/$defs/numericRange" },
            "normalize_to_simplex_note": { "type": "string" }
          }
        },
        "delivery_modalities": {
          "type": ["object", "null"],
          "description": "Surge delivery ω — same simplex as strikes; blends blunt vs pierce vs slash into special mitigation",
          "properties": {
            "concussive": { "$ref": "#/$defs/numericRange" },
            "piercing": { "$ref": "#/$defs/numericRange" },
            "slashing": { "$ref": "#/$defs/numericRange" },
            "normalize_to_simplex_note": { "type": "string" }
          }
        },
        "cooldown_scaling": {
          "type": "object",
          "required": ["min_turns", "max_turns", "scales_with"],
          "properties": {
            "min_turns": { "type": "number", "minimum": 0 },
            "max_turns": { "type": "number", "minimum": 0 },
            "scales_with": { "type": "string" },
            "help": { "type": "string" }
          }
        },
        "infusion_coeffs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/numericRange" }
        },
        "status_payloads": {
          "type": "object",
          "description": "Bounds for attaching status_catalog effects — COMBAT-MODEL §3, ATTACK-CATALOG status section.",
          "required": ["max_attachments", "help"],
          "properties": {
            "max_attachments": { "type": "integer", "minimum": 0, "maximum": 8 },
            "potency": { "$ref": "#/$defs/numericRange" },
            "duration_subticks": { "$ref": "#/$defs/numericRange" },
            "proc_chance": { "$ref": "#/$defs/numericRange" },
            "allowed_proc_lanes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["on_hit", "on_crit", "channel_tick", "self", "target"]
              },
              "uniqueItems": true
            },
            "help": { "type": "string" }
          },
          "additionalProperties": false
        },
        "accumulator_impulses": {
          "type": "object",
          "description": "Layer 3 Δ bands keyed by event lane — GAMEPLAY-SYSTEMS §2.1.",
          "required": ["help", "on_hit"],
          "properties": {
            "help": { "type": "string" },
            "on_hit": {
              "type": "object",
              "description": "Impulses when the move connects (resolver applies after modality pipeline).",
              "additionalProperties": { "$ref": "#/$defs/numericRange" }
            },
            "on_crit": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/numericRange" }
            }
          },
          "additionalProperties": false
        },
        "passive_hooks": {
          "type": "object",
          "description": "Optional slot-bound passive affinity shaping — GAMEPLAY-SYSTEMS §1.3.",
          "properties": {
            "allow_slot_passive": { "type": "boolean" },
            "emphasis_tail_budget": { "$ref": "#/$defs/numericRange" },
            "help": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "exampleBuild": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "primary_affinity": {
          "anyOf": [{ "$ref": "#/$defs/affinity" }, { "type": "null" }]
        },
        "secondary_affinity": {
          "anyOf": [{ "$ref": "#/$defs/affinity" }, { "type": "null" }]
        },
        "blend_eta": { "type": "number" },
        "affinity_weights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "base_power": { "type": "number", "minimum": 0 },
        "pierce": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 100 },
        "strike_modalities": {
          "type": "object",
          "properties": {
            "concussive": { "type": "number" },
            "piercing": { "type": "number" },
            "slashing": { "type": "number" }
          }
        },
        "delivery_modalities": {
          "type": "object",
          "properties": {
            "concussive": { "type": "number" },
            "piercing": { "type": "number" },
            "slashing": { "type": "number" }
          }
        },
        "cooldown_turns": { "type": "integer", "minimum": 0 },
        "infusion_coeffs": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status_payloads_note": {
          "type": "string",
          "description": "Illustrative — resolved selections reference status_catalog ids at equip time."
        },
        "accumulator_impulses_selection": {
          "type": "object",
          "description": "Resolved on_hit / on_crit deltas for tooling mocks.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        },
        "passive_hooks_selection": {
          "type": "object",
          "properties": {
            "emphasis_tail_budget": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
